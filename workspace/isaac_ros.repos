# Isaac ROS dependencies for nvblox multi-camera mapping.
#
# Clone these into workspace/src/external_pkgs/ with:
#   cd workspace/src/external_pkgs
#   vcs import < ../../isaac_ros.repos
#
# Or run the helper:
#   ./workspace/clone_isaac_ros.sh

repositories:
  isaac_ros_common:
    type: git
    url: https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_common.git
    version: main
  isaac_ros_nitros:
    type: git
    url: https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_nitros.git
    version: main
  isaac_ros_image_pipeline:
    type: git
    url: https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_image_pipeline.git
    version: main
  isaac_ros_nvblox:
    type: git
    url: https://github.com/NVIDIA-ISAAC-ROS/isaac_ros_nvblox.git
    version: main
  negotiated:
    type: git
    url: https://github.com/osrf/negotiated.git
    version: master
