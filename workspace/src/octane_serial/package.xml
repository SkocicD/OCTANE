<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>octane_serial</name>
  <version>0.0.0</version>
  <description>Serial bridge for OCTANE actuator relays. Subscribes to ActuatorCommand and emits a 4-bit relay state byte over UART; an Arduino drives the relays.</description>
  <maintainer email="adam.r.carbone@live.com">Adam Carbone</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>octane_msgs</depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
