<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>octane_gpio</name>
  <version>0.0.0</version>
  <description>GPIO hardware interface for OCTANE actuator relays. Subscribes to actuator commands and triggers Jetson GPIO pins for arm and bucket relays.</description>
  <maintainer email="adam.r.carbone@live.com">Adam Carbone</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>octane_msgs</depend>

  <!-- TODO: add Jetson.GPIO dependency once pin mapping is confirmed -->

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
