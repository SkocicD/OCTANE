+def wheel_side_symmetry(
+    env, asset_cfg: SceneEntityCfg = SceneEntityCfg("robot")
+) -> torch.Tensor:
+    """Penalize wheels on the same side having different velocities.
+
+    For skid-steer: left wheels (indices 0-2) should match each other,
+    right wheels (indices 3-5) should match each other.
+    """
+    asset = env.scene[asset_cfg.name]
+    joint_vel = asset.data.joint_vel[:, asset_cfg.joint_ids]  # [N, 6]
+    left_vel = joint_vel[:, :3]
+    right_vel = joint_vel[:, 3:]
+    left_variance = left_vel.var(dim=-1)
+    right_variance = right_vel.var(dim=-1)
+    return -(left_variance + right_variance)
+
+
+def maximize_wheel_speed(
+    env, asset_cfg: SceneEntityCfg = SceneEntityCfg("robot")
+) -> torch.Tensor:
+    """Reward high wheel angular velocity — diagnostic reward to verify wheels can spin fast."""
+    asset = env.scene[asset_cfg.name]
+    return asset.data.joint_vel[:, asset_cfg.joint_ids].abs().mean(dim=-1)
+
+
+def wheel_spin_without_motion(
+    env, asset_cfg: SceneEntityCfg = SceneEntityCfg("robot")
+) -> torch.Tensor:
+    """Penalize wheel spinning when the robot base isn't translating.
+
+    Discourages the policy from exploiting oscillating wheel commands that don't
+    produce actual robot movement (wheel slip / stationary spinning exploit).
+    """
+    asset = env.scene[asset_cfg.name]
+    wheel_speed = asset.data.joint_vel[:, asset_cfg.joint_ids].abs().mean(dim=-1)
+    base_speed = asset.data.root_lin_vel_b[:, :2].norm(dim=-1)
+    # Penalty is large when wheels spin but robot doesn't translate.
+    # exp(-5 * base_speed): ~1.0 at rest, ~0.22 at 0.3 m/s, ~0.05 at 0.6 m/s
+    return -(wheel_speed * torch.exp(-5.0 * base_speed))