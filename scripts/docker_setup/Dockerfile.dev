# Development Dockerfile for OCTANE
# Lightweight image for development and testing

# Use the dependencies layer as base
FROM octane-deps:latest

# Add development tools
RUN apt update && apt install -y \
    build-essential \
    gdb \
    valgrind \
    vim \
    nano \
    htop \
    curl \
    wget

# Set working directory
WORKDIR /workspace

# Copy workspace sources
COPY workspace /workspace

# Source ROS2 setup
RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc

# Default command
CMD ["/bin/bash"]