# Multi-stage Dockerfile for OCTANE with build configuration options
# Usage: docker build --build-arg BUILD_TYPE=full -f Dockerfile.multistage .

# Build arguments for different configurations
ARG BUILD_TYPE=minimal

# Base image with NVIDIA Isaac ROS
FROM nvcr.io/nvidia/isaac/ros:isaac_ros_054e16b5c3a328b621af47d26009c348-arm64-fastos

# Install essential system dependencies (always needed)
RUN apt update && apt install -y python3-colcon-common-extensions git

# Install core ROS dependencies
RUN apt update && apt install -y \
    ros-humble-camera-info-manager \
    ros-humble-cv-bridge \
    ros-humble-image-publisher \
    libusb-1.0-0-dev

# Install full dependencies (conditional)
RUN if [ "$BUILD_TYPE" = "full" ]; then \
    apt update && apt install -y \
    ros-humble-desktop \
    libuvc-dev \
    libgoogle-glog-dev \
    nlohmann-json3-dev \
    libeigen3-dev \
    libopenmpi-dev \
    python3-dev \
    cmake \
    build-essential \
    python3-pip \
    python3-venv \
    python3-numpy \
    python3-opencv \
    libglfw3-dev \
    libosmesa6-dev; \
    fi

# Install Python packages (conditional)
RUN if [ "$BUILD_TYPE" = "full" ]; then \
    pip3 install --no-cache-dir \
    einops \
    huggingface_hub \
    imageio \
    "numpy<2" \
    opencv-python \
    fastapi \
    uvicorn \
    requests \
    typer \
    pillow \
    omegaconf \
    plyfile \
    safetensors \
    pillow_heif || \
    echo "Warning: Some Python packages failed to install"; \
    fi

WORKDIR /workspace

# Copy workspace sources
COPY ../workspace /workspace

# Build Orbbec camera (if needed)
RUN if [ "$BUILD_TYPE" = "full" ]; then \
    cd /workspace && \
    colcon build --packages-select ros2_astra_camera --cmake-args -DCMAKE_BUILD_TYPE=Release || \
    echo "Warning: ros2_astra_camera build failed or not found"; \
    fi

# Set environment variables
ENV PYTHONPATH=${PYTHONPATH}:/workspace/src/external_pkgs/depth-anything-3/src
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc