# Multi-stage Dockerfile for OCTANE with dependency and application separation
# This allows building just dependencies or the full application

# Stage 1: Dependencies layer (infrequently changed)
FROM nvcr.io/nvidia/isaac/ros:isaac_ros_054e16b5c3a328b621af47d26009c348-arm64-fastos AS dependencies

# Install CUDA repository and tools
RUN apt update && apt install -y software-properties-common wget
RUN wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2004/sbsa/cuda-keyring_1.0-1_all.deb && \
    dpkg -i cuda-keyring_1.0-1_all.deb
RUN apt update

# Install system dependencies that rarely change
RUN apt update && apt install -y \
    python3-colcon-common-extensions \
    git \
    libusb-1.0-0-dev \
    cuda-toolkit-12-6 \
    cuda-toolkit-config-common \
    cuda-toolkit-12-config-common \
    cuda-toolkit-12-6-config-common \
    libnpp-12-6 \
    libnvjpeg-12-6 \
    libnpp-dev-12-6 \
    libnvjpeg-dev-12-6

# Install ROS dependencies
RUN apt update && apt install -y \
    ros-jazzy-camera-info-manager \
    ros-jazzy-cv-bridge \
    ros-jazzy-image-publisher \
    ros-jazzy-desktop \
    libuvc-dev \
    libgoogle-glog-dev \
    nlohmann-json3-dev \
    libeigen3-dev \
    libopenmpi-dev \
    python3-dev \
    cmake \
    build-essential \
    python3-pip \
    python3-venv \
    python3-numpy \
    python3-opencv \
    libglfw3-dev \
    libosmesa6-dev || \
    echo "Warning: Failed to install some dependencies, continuing anyway"

# Install Python dependencies
RUN pip3 install --no-cache-dir \
    einops \
    huggingface_hub \
    imageio \
    "numpy<2" \
    opencv-python \
    fastapi \
    uvicorn \
    requests \
    typer \
    pillow \
    omegaconf \
    plyfile \
    safetensors \
    pillow_heif || \
    echo "Warning: Some Python packages failed to install, continuing anyway"

# Stage 2: Application layer (frequently changed) - depends on dependencies stage
FROM dependencies AS application

# Clean any existing build cache to prevent CMake conflicts
RUN rm -rf /workspace/build/* 2>/dev/null || true

WORKDIR /workspace

# Copy workspace sources
COPY workspace /workspace

# Build Orbbec camera package
RUN cd /workspace && \
    colcon build --packages-select ros2_astra_camera --cmake-args -DCMAKE_BUILD_TYPE=Release || \
    echo "Warning: ros2_astra_camera build failed or not found"

# Set environment variables
ENV PYTHONPATH=/workspace/src/external_pkgs/depth-anything-3/src
RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc