Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: left_front
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/camera/near/left_front/rgb/image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: left_side
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/camera/near/left_side/rgb/image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: right_front
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/camera/near/right_front/rgb/image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: right_side
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/camera/near/right_side/rgb/image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: back_rear
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/camera/near/back_rear/rgb/image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: orbbec_rgb
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /camera/color/image_raw
      Value: true
  Global Options:
    Fixed Frame: map
  Name: root
