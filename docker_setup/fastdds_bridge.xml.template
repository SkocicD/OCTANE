<?xml version="1.0" encoding="UTF-8" ?>
<dds>
    <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
        <participant profile_name="isaac_sim_bridge" is_default_profile="true">
            <rtps>
                <builtin>
                    <!--
                        Multicast discovery does not cross the WSL2/Windows network boundary.
                        We add the Windows Isaac Sim host as explicit unicast initial peers.
                        Multicast attempts are left in place and will fail silently — this keeps
                        the profile compatible if the container is ever run on a same-subnet setup.

                        NOTE: FastDDS ENV-var XML expansion is not supported for address fields in
                        FastDDS 2.6.x (ROS 2 Humble). envsubst runs inside the container at startup
                        (see docker-compose command:) to substitute ISAAC_SIM_HOST before FastDDS loads.
                    -->
                    <initialPeersList>
                        <!-- Isaac Sim Windows host — SPDP well-known unicast ports for domain 0 -->
                        <locator>
                            <udpv4>
                                <address>${ISAAC_SIM_HOST}</address>
                                <port>7412</port>
                            </udpv4>
                        </locator>
                        <locator>
                            <udpv4>
                                <address>${ISAAC_SIM_HOST}</address>
                                <port>7410</port>
                            </udpv4>
                        </locator>
                    </initialPeersList>
                </builtin>
            </rtps>
        </participant>
    </profiles>
</dds>
