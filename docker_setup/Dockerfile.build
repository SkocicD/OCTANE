FROM ros:humble
SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/New_York

# Install essential packages
RUN apt update && apt install -y python3-colcon-common-extensions git python3-pip libusb-1.0-0-dev

# Install comprehensive ROS desktop and dependencies
RUN apt update && apt install -y \
    ros-humble-desktop \
    libuvc-dev \
    libgoogle-glog-dev \
    nlohmann-json3-dev \
    libeigen3-dev \
    libopenmpi-dev \
    python3-dev \
    cmake \
    build-essential

# Install Python dependencies
RUN pip3 install --no-cache-dir \
    einops \
    huggingface_hub \
    imageio \
    "numpy<2" \
    opencv-python \
    fastapi \
    uvicorn \
    requests \
    typer \
    pillow \
    omegaconf \
    plyfile \
    safetensors \
    pillow_heif || \
    echo "Warning: Some Python packages failed to install"

# Copy workspace sources (excluding build/install/log)
WORKDIR /workspace
COPY ../workspace/src /workspace/src
COPY ../workspace/build_system.sh ../workspace/clone_isaac_ros.sh /workspace/

# Source ROS2 setup
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc

# Default command
CMD ["/bin/bash"]
